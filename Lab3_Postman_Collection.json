    {
      "name": "GET /books - Default Pagination & Sort (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Response is an array', () => {",
              "    pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/books",
          "host": ["{{base_url}}"],
          "path": ["books"]
        }
      }
    },
    {
      "name": "GET /books - Search, Price Filter, and Order (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Response is an array', () => {",
              "    pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/books?search_q=Clean&min_price=10&max_price=50&order_by=price&order=DESC&limit=5&offset=0",
          "host": ["{{base_url}}"],
          "path": ["books"],
          "query": [
            { "key": "search_q", "value": "Clean" },
            { "key": "min_price", "value": "10" },
            { "key": "max_price", "value": "50" },
            { "key": "order_by", "value": "price" },
            { "key": "order", "value": "DESC" },
            { "key": "limit", "value": "5" },
            { "key": "offset", "value": "0" }
          ]
        }
      }
    },
    {
      "name": "GET /books - Failure: Negative Limit & Offset (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 400 Bad Request', () => pm.response.to.have.status(400));",
