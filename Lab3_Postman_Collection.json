              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/books?order_by=DROP_TABLE",
          "host": ["{{base_url}}"],
          "path": ["books"],
          "query": [
            { "key": "order_by", "value": "DROP_TABLE" }
          ]
        }
      }
    },
    {
      "name": "GET /books/:id - Existing ID (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Returns book record', () => {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('id');",
              "    pm.expect(json).to.have.property('title');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/books/1",
          "host": ["{{base_url}}"],
          "path": ["books", "1"]
        }
      }
    },
